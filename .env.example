# =============================================================================
# iCertiX Backend — Production Environment Variables Blueprint (AWS)
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Security & Secrets (GENERATE A STRONG 256-BIT SECRET IN PRODUCTION)
JWT_SECRET=your-secure-production-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=7d

# CORS & Frontend URL
CORS_ORIGIN=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# PostgreSQL Database (Amazon RDS PostgreSQL)
# Example: postgresql://dbuser:StrongPassword@icertix-db.cxxxx.us-east-1.rds.amazonaws.com:5432/icertix_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/icertix_db
DB_SSL=true
DB_POOL_MAX=20
DB_SYNCHRONIZE=true

# AWS Configuration (IAM Role or API Credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Amazon S3 Media Storage (Certificate PDFs, University Logos, Signatures)
AWS_S3_BUCKET=icertix-production-assets
AWS_S3_CUSTOM_DOMAIN=https://assets.yourdomain.com

# Amazon SES (Simple Email Service - Transactional Emails)
AWS_SES_FROM_EMAIL=certificates@yourdomain.com
AWS_SES_REPLY_TO=support@yourdomain.com

# Cryptography & HSM Key Identifier
HSM_KEY_ID=HSM-ICX-ED25519-PROD01
VERIFICATION_BASE_URL=https://app.yourdomain.com/verify/
